# Copy this file to .env and fill in whichever free-tier keys you have.
# The harness runs in MOCK MODE for any provider whose key is missing,
# so you can leave one or two blank and it will still run end-to-end.
# This project does not require paid credits or paid API access.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Optional: OpenRouter free models have strict daily limits and are not part of
# the default model configuration.
OPENROUTER_API_KEY=
