# Copy this file to .env and fill in whichever free-tier keys you have.
# The harness runs in MOCK MODE for any provider whose key is missing,
# so you can leave one or two blank and it will still run end-to-end.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Get a free key at https://openrouter.ai/keys (use ":free" model IDs to avoid any charges)
OPENROUTER_API_KEY=
